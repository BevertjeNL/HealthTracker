# Neon Postgres connection string (from Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Strava API app (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random secret to protect the /api/strava/sync cron endpoint
CRON_SECRET=

# Random secret to protect /api/health/ingest (use the same value in Apple Shortcuts)
HEALTH_INGEST_SECRET=

# Single-user login. Use a unique password of at least 16 characters.
APP_PASSWORD=

# Signs login sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=
